.page {
  padding-top: 20rpx;
}

/* ---------- 月份切换 ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.month-switch {
  display: flex;
  align-items: center;
}

.month-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5A626B;
  font-size: 34rpx;
  background: #FFFFFF;
}

.month-btn:active {
  background: #EDEFF2;
}

.month-text {
  margin: 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2429;
}

.summary {
  font-size: 24rpx;
  color: #9AA0A6;
}

/* ---------- 类型筛选 ---------- */
.type-bar {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.type-bar .chips {
  padding: 4rpx 0;
}

/* ---------- 分组 ---------- */
.group {
  margin-bottom: 28rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #5A626B;
}

.group-count {
  font-size: 22rpx;
  color: #B6BBC1;
}

.group-body {
  padding: 4rpx 28rpx;
}

.row:last-child .divider {
  display: none;
}

.empty {
  margin-top: 120rpx;
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
