<view class="page">

  <scroll-view class="type-bar" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="chips">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="chip {{activeType === item.key ? 'is-active' : ''}}"
        style="{{activeType === item.key ? 'background:' + item.color + ';border-color:' + item.color : ''}}"
        data-type="{{item.key}}"
        bindtap="onTabChange"
      >
        <text>{{item.icon}} {{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="seg-wrap">
    <view class="seg {{days === 7 ? 'is-active' : ''}}" data-days="7" bindtap="onPeriodChange">近 7 天</view>
    <view class="seg {{days === 30 ? 'is-active' : ''}}" data-days="30" bindtap="onPeriodChange">近 30 天</view>
  </view>

  <!-- 指标卡 -->
  <view class="card stats">
    <view class="stat" wx:for="{{cards}}" wx:key="label">
      <text class="stat-label">{{item.label}}</text>
      <text class="stat-value">{{item.value}}</text>
    </view>
  </view>

  <!-- 趋势 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">{{typeName}}趋势</text>
      <text class="section-more">{{rangeText}}</text>
    </view>

    <view class="card chart">
      <block wx:if="{{hasData}}">
        <view class="bars">
          <view class="bar-col" wx:for="{{bars}}" wx:key="date">
            <view class="bar-track">
              <view
                wx:if="{{item.has}}"
                class="bar-fill"
                style="height:{{item.height}}%;background:{{typeColor}}"
              ></view>
            </view>
            <text class="bar-label">{{item.showLabel ? item.label : ''}}</text>
          </view>
        </view>
        <view class="chart-foot">
          <text>{{maxLabel}} {{maxText}}</text>
          <text>{{minText}}</text>
        </view>
      </block>

      <view wx:else class="empty">
        <text class="empty-icon">📈</text>
        <text class="empty-text">{{rangeText}}还没有{{typeName}}记录</text>
      </view>
    </view>
  </view>

  <!-- 分布 -->
  <view class="section" wx:if="{{distro.length}}">
    <view class="section-head">
      <text class="section-title">{{distroTitle}}</text>
    </view>
    <view class="card">
      <view class="dist" wx:for="{{distro}}" wx:key="label">
        <view class="dist-head">
          <text class="dist-label">{{item.label}}</text>
          <text class="dist-value">{{item.text}} · {{item.percent}}%</text>
        </view>
        <view class="dist-track">
          <view class="dist-fill" style="width:{{item.percent}}%;background:{{typeColor}}"></view>
        </view>
      </view>
    </view>
  </view>

</view>
