.rc {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.rc-hover {
  background: #FAFBFC;
}

.rc-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.rc-main {
  flex: 1;
  min-width: 0;
}

.rc-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #1F2429;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9AA0A6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-right {
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
}

.rc-value {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.rc-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B6BBC1;
}
