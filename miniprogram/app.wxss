/* ================= 全局设计变量 ================= */
page {
  --c-primary: #2F7D6D;
  --c-primary-soft: rgba(47, 125, 109, 0.10);
  --c-text: #1F2429;
  --c-text-2: #5A626B;
  --c-text-3: #9AA0A6;
  --c-line: #EDEFF2;
  --c-bg: #F6F7F9;
  --c-card: #FFFFFF;
  --c-danger: #E4574C;

  --radius-lg: 28rpx;
  --radius-md: 20rpx;
  --radius-sm: 12rpx;

  background-color: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ================= 布局 ================= */
.page {
  min-height: 100vh;
  padding: 0 28rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 底部 tabBar 之外的悬浮按钮安全距离 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ================= 卡片 ================= */
.card {
  background: var(--c-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(31, 36, 41, 0.04);
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  letter-spacing: 0.5rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--c-text-3);
}

/* ================= 筛选项 ================= */
.chips {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.chip {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--c-text-2);
  font-size: 26rpx;
  line-height: 1.4;
  border: 1rpx solid var(--c-line);
  transition: all 0.15s ease;
  /* 不用 flex gap：低版本 iOS WebView 不支持，会挤在一起 */
  margin-right: 16rpx;
}

.chip:last-child {
  margin-right: 0;
}

.chip.is-active {
  background: var(--c-primary);
  color: #FFFFFF;
  border-color: var(--c-primary);
  font-weight: 500;
}

/* ================= 空状态 ================= */
.empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  color: var(--c-text-3);
}

/* ================= 悬浮按钮 ================= */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--c-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 12rpx 32rpx rgba(47, 125, 109, 0.32);
  z-index: 20;
}

.fab:active {
  transform: scale(0.94);
}

/* ================= 通用文本 ================= */
.t-sub {
  font-size: 24rpx;
  color: var(--c-text-3);
}

.t-strong {
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: var(--c-line);
}
